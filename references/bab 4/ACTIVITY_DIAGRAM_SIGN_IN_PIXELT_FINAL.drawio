  <diagram name="Activity Diagram Sign In PIXEL-T Final" id="act-signin-final">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="1050" math="0" shadow="0">
      <mxCell id="0">
        <mxCell id="1" parent="0">
          <mxCell id="st" vertex="0" parent="1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" />
          <mxCell id="en" vertex="0" parent="1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" />
          <mxCell id="en_in" vertex="0" parent="1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" />
          <mxCell id="a1" vertex="1" parent="1" source="st" target="a1" edge="0" value="Membuka halaman /login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;arcSize=20;" />
          <mxCell id="a2" vertex="1" parent="1" source="a1" target="a2" edge="0" value="Mengisi email, kata sandi,&amp;lt;br&amp;gt;dan memilih jenis akun" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;arcSize=20;" />
          <mxCell id="a3" vertex="1" parent="1" source="a2" target="a3" edge="0" value="Memvalidasi input&amp;lt;br&amp;gt;(email wajib, kata sandi wajib)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;arcSize=20;" />
          <mxCell id="d1" vertex="1" parent="1" source="a3" target="d1" edge="0" value="Input valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;" />
          <mxCell id="aerr" vertex="0" parent="1" source="d1" target="aerr" edge="1" value="Menampilkan pesan kesalahan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;arcSize=20;" />
          <mxCell id="a4" vertex="0" parent="1" source="d1" target="a4" edge="1" value="Memanggil signIn() → supabase.auth.signInWithPassword()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;arcSize=20;" />
          <mxCell id="d2" vertex="0" parent="1" source="a4" target="d2" edge="1" value="Kredensial valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;" />
          <mxCell id="a5" vertex="0" parent="1" source="d2" target="a5" edge="1" value="Memperbarui sesi &amp;amp; state autentikasi&amp;lt;br&amp;gt;(user, session, role, account_status)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;arcSize=20;" />
          <mxCell id="d3" vertex="0" parent="1" source="a5" target="d3" edge="1" value="Role cocok dengan akun?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;" />
          <mxCell id="a6" vertex="0" parent="1" source="d3" target="a6" edge="1" value="Menampilkan pesan jenis akun tidak sesuai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;arcSize=20;" />
          <mxCell id="d4" vertex="0" parent="1" source="d3" target="d4" edge="1" value="Role = admin?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;" />
          <mxCell id="a7" vertex="0" parent="1" source="d4" target="a7" edge="1" value="Mengarahkan ke /admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;arcSize=20;" />
          <mxCell id="d5" vertex="0" parent="1" source="d4" target="d5" edge="1" value="Akun pending?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;" />
          <mxCell id="a8" vertex="0" parent="1" source="d5" target="a8" edge="1" value="Kembali ke /login (menunggu persetujuan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;arcSize=20;" />
          <mxCell id="d6" vertex="0" parent="1" source="d5" target="d6" edge="1" value="Akun ditolak?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;" />
          <mxCell id="a9" vertex="0" parent="1" source="d6" target="a9" edge="1" value="Kembali ke /login (pendaftaran ditolak)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;arcSize=20;" />
          <mxCell id="a10" vertex="0" parent="1" source="d5" target="a10" edge="1" value="Mengakses halaman tujuan&amp;lt;br&amp;gt;(dashboard atau halaman sebelumnya)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;arcSize=20;" />
          <mxCell id="note" vertex="1" parent="1" edge="0" value="Catatan:&amp;lt;br&amp;gt;Halaman /login dilindungi PublicOnlyRoute.&amp;lt;br&amp;gt;Role selector memungkinkan pengguna memilih konteks login (Admin/Dokter).&amp;lt;br&amp;gt;Fitur &quot;Remember my email&quot; hanya menyimpan alamat email di localStorage.&amp;lt;br&amp;gt;Halaman Reset Password merupakan use case terpisah." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;dashed=1;fontColor=#000000;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" />
