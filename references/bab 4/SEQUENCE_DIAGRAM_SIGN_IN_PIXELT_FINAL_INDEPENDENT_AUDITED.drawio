        <mxCell id="note1" value="• Login menggunakan Supabase Auth (signInWithPassword), tidak ada panggilan Flask API" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=8;" vertex="1" parent="f1">
          <mxGeometry x="18" y="638" width="550" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="note2" value="• Role Admin: app_metadata.role (server-write-only, dibaca dari JWT token, tidak dapat diubah client)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=8;" vertex="1" parent="f1">
          <mxGeometry x="18" y="652" width="520" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="note3" value="• Role Dokter: doctor_profiles.role (diambil dari database melalui AuthService.fetchUserProfileStatus)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=8;" vertex="1" parent="f1">
