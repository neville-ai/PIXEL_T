# Application Environment Configuration
APP_ENV=development
BACKEND_PORT=5000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:5000/api

# Frontend Supabase Credentials (Vite exposed - Anon Key only, NEVER expose Service Role Key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend Supabase Credentials (Server-only - Trusted server environment)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=analysis-assets

# Server Secret Key
SECRET_KEY=

# AI Model Configuration
MODEL_PATH=
MODEL_CHECKPOINT_PATH=
MODEL_VERSION=
MODEL_CONFIG_VERSION=
MODEL_DEVICE=auto
MODEL_INFERENCE_ENABLED=false
MODEL_INPUT_SIZE=
MODEL_THRESHOLD=
TTA_ENABLED=
POSTPROCESSING_ENABLED=
GRADCAM_TARGET_LAYER=
