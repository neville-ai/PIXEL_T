@startuml activity-sign-in
' =====================================================================
'  Activity Diagram Sign In - PIXEL-T  (versi revisi final)
'  Diverifikasi dari: Login.tsx (baris 71-155), services/auth.ts,
'  AuthContext.tsx
'
'  Alur mencerminkan revisi diagram:
'   - User mengisi email + kata sandi terlebih dahulu
'   - Percabangan "Lupa Kata Sandi?" setelah input
'   - Validasi FORMAT email pada alur reset (EMAIL_PATTERN)
'   - Catatan: ResetPassword.tsx diakses via link email Supabase
'   - repeat-while untuk loop percobaan ulang
' =====================================================================

title Activity Diagram Sign In - PIXEL-T

skinparam backgroundColor white
skinparam activity {
  BackgroundColor #60E5E6
  BorderColor #333333
  FontColor #222222
  DiamondBackgroundColor #60E5E6
  DiamondBorderColor #333333
  StartColor black
  EndColor black
}
skinparam ArrowColor #333333
skinparam shadowing false

|User|
start
:Membuka halaman Sign In;

repeat

  |User|
  :Mengisi email dan kata sandi;

  if (Memilih Lupa Kata Sandi?) then (Ya)

    :Memasukkan email untuk reset kata sandi;

    |System|
    :Memvalidasi format email;

    if (Format email valid?) then (Ya)
      :Memanggil resetPasswordForEmail();

      note right
        ResetPassword.tsx dapat diakses
        melalui tautan pemulihan dari email
        yang dikirim oleh Supabase Auth.
      end note

      :Menampilkan status permintaan reset;
    else (Tidak)
      :Menampilkan pesan format email tidak valid;
    endif

    |User|
    :Kembali ke halaman Sign In;

  else (Tidak)

    |User|
    :Menekan tombol Masuk;

    |System|
    :Memvalidasi kelengkapan input;

    if (Input lengkap?) then (Tidak)
      :Menampilkan pesan input wajib diisi;
    else (Ya)
      :Memanggil signInWithPassword();

      if (Login berhasil?) then (Ya)
        :Memperbarui status autentikasi;

        if (Tujuan sebelumnya tersedia?) then (Ya)
          :Membuka tujuan sebelumnya;
        else (Tidak)
          :Membuka Dashboard;
        endif
        stop

      else (Tidak)
        :Menampilkan pesan login gagal;
      endif
    endif

  endif

repeat while (Mencoba kembali?) is (Ya) not (Tidak)

stop
@enduml
