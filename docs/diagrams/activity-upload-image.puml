@startuml activity-upload-image
' =====================================================================
'  Activity Diagram Upload Image - PIXEL-T (Versi Revisi Final)
'  Diverifikasi dari: NewAnalysis.tsx, services/analysis.ts
'
'  Alur mencerminkan implementasi aktual:
'   1. Validasi file dilakukan di sisi frontend (format, ukuran, dimensi)
'      sebelum dikirim ke backend (validateFile + createImageBitmap).
'   2. Pratinjau ditampilkan SETELAH validasi lolos (URL.createObjectURL).
'   3. Upload ke backend menggunakan createAnalysis() → respons HTTP 202.
'   4. Sistem melakukan polling status analisis setiap 2 detik.
'   5. Navigasi ke halaman hasil setelah status "completed" / "failed".
'   6. Kegagalan validasi dan kegagalan upload menggunakan repeat-while loop.
' =====================================================================

title Activity Diagram Upload Image - PIXEL-T

skinparam backgroundColor white
skinparam activity {
  BackgroundColor #60E5E6
  BorderColor #333333
  FontColor #222222
  DiamondBackgroundColor #60E5E6
  DiamondBorderColor #333333
  StartColor black
  EndColor black
}
skinparam ArrowColor #333333
skinparam shadowing false

|User|
start
:Membuka fitur Upload Image;

|System|
:Menampilkan area unggah gambar;

repeat

  |User|
  :Memilih gambar untuk diunggah;
  note right
    Format: JPG, JPEG, PNG
    Ukuran maksimum: 10 MB
  end note

  |System|
  :Memvalidasi file gambar;
  note right
    Validasi dilakukan di sisi frontend:
    format ekstensi, MIME type,
    ukuran file, dan dimensi gambar
  end note

  if (File valid?) then (Ya)

    :Menampilkan pratinjau gambar;

    |User|
    :Menekan tombol Start Analysis;

    |System|
    :Mengirim gambar ke backend;

    if (Upload berhasil?) then (Ya)
      :Menerima respons analisis diterima;
      :Menampilkan panel progres analisis;

      repeat
        :Memeriksa status analisis;
        note right
          Polling setiap 2 detik
          hingga status terminal
        end note
      repeat while (Status terminal?) is (Tidak) not (Ya)

      :Mengarahkan ke halaman Hasil Analisis;
      stop

    else (Tidak)
      :Menampilkan pesan kesalahan upload;
    endif

  else (Tidak)
    :Menampilkan pesan validasi gagal;
  endif

repeat while (Mencoba kembali?) is (Ya) not (Tidak)

stop
@enduml
