@startuml activity-doctor-profile
' =====================================================================
'  Activity Diagram Profil Dokter (Doctor Profile) - PIXEL-T (Versi Revisi Final)
'  Diverifikasi dari: DoctorProfile.tsx, services/profile.ts, services/analysis.ts
'
'  Alur mencerminkan implementasi aktual:
'   1. Sistem memuat data profil dokter (fetchDoctorProfile) dan
'      statistik analisis (listHistory) secara paralel saat halaman dibuka.
'   2. Pengguna melihat informasi profil, kelengkapan profil, statistik,
'      dan tiga riwayat analisis terbaru.
'   3. Pengguna dapat mengedit profil melalui modal dengan 5 tab:
'      Personal, Professional, Education, Experience, Bio.
'   4. Penyimpanan profil memanggil saveDoctorProfile ke backend (Supabase).
' =====================================================================

title Activity Diagram Profil Dokter (Doctor Profile) - PIXEL-T

skinparam backgroundColor white
skinparam activity {
  BackgroundColor #60E5E6
  BorderColor #333333
  FontColor #222222
  DiamondBackgroundColor #60E5E6
  DiamondBorderColor #333333
  StartColor black
  EndColor black
}
skinparam ArrowColor #333333
skinparam shadowing false

|User|
start
:Membuka halaman Profil Dokter;

|System|
:Memuat data profil dokter dari backend;
:Memuat statistik dan riwayat analisis dari backend;

if (Data profil berhasil dimuat?) then (Tidak)
  :Menampilkan pesan kesalahan memuat profil;
endif

:Menampilkan halaman Profil Dokter;
note right
  Menampilkan:
  - Foto, nama, dan gelar akademik dokter
  - Persentase kelengkapan profil
  - Statistik analisis (Total / Selesai / Proses / Gagal)
  - 3 riwayat analisis terbaru
  - Informasi identitas, profesional, pendidikan, pengalaman, bio
end note

|User|
if (Memilih aksi pada halaman profil?) then (Edit Profil)
  :Menekan tombol Edit Profile;

  |System|
  :Membuka modal Edit Profil;
  note right
    Modal memiliki 5 tab:
    Personal / Professional /
    Education / Experience / Bio
  end note

  |User|
  :Memilih tab dan mengisi atau mengubah data profil;
  note right
    Tab Education dan Experience
    mendukung tambah (+) dan hapus
    entri secara dinamis
  end note

  :Menekan tombol Simpan Profil;

  |System|
  :Memvalidasi data formulir;

  if (Data valid?) then (Ya)
    :Menyimpan profil ke backend (saveDoctorProfile);

    if (Penyimpanan berhasil?) then (Ya)
      :Memperbarui tampilan profil dengan data terbaru;
      :Menampilkan notifikasi profil berhasil diperbarui;
      :Menutup modal Edit Profil;
    else (Tidak)
      :Menampilkan pesan kesalahan penyimpanan;
    endif
  else (Tidak)
    :Menampilkan pesan validasi gagal;
  endif

else (Lihat Riwayat Analisis)
  :Menekan tombol Lihat Semua Riwayat Analisis;

  |System|
  :Mengarahkan ke halaman Riwayat Analisis;
  stop

endif

|User|
stop
@enduml
