@startuml activity-history
' =====================================================================
'  Activity Diagram Riwayat Analisis (History) - PIXEL-T (Versi Revisi Final)
'  Diverifikasi dari: History.tsx, services/analysis.ts
'
'  Alur mencerminkan implementasi aktual:
'   1. Sistem memuat riwayat dari API (listHistory).
'   2. Pengguna dapat melakukan pencarian dan penyaringan data (client-side).
'   3. Pengguna dapat melihat detail hasil analisis atau menghapus riwayat.
'   4. Penghapusan riwayat dilakukan melalui modal konfirmasi (deleteAnalysis).
' =====================================================================

title Activity Diagram Riwayat Analisis (History) - PIXEL-T

skinparam backgroundColor white
skinparam activity {
  BackgroundColor #60E5E6
  BorderColor #333333
  FontColor #222222
  DiamondBackgroundColor #60E5E6
  DiamondBorderColor #333333
  StartColor black
  EndColor black
}
skinparam ArrowColor #333333
skinparam shadowing false

|User|
start
:Membuka halaman Riwayat Analisis;

|System|
:Mengambil data riwayat dari backend;

if (Data berhasil dimuat?) then (Tidak)
  :Menampilkan pesan kesalahan;
  |User|
  :Menekan tombol Coba Lagi;
  |System|
  :Mengambil ulang data riwayat;
endif

if (Daftar riwayat kosong?) then (Ya)
  :Menampilkan halaman riwayat kosong;
  note right
    Pesan "Belum ada riwayat analisis"
    dengan tombol Mulai Analisis Baru
  end note
  |User|
  :Menekan tombol Mulai Analisis Baru;
  |System|
  :Mengarahkan ke halaman Upload Gambar;
  stop
else (Tidak)
  :Menampilkan daftar riwayat dan bilah filter;
endif

|User|
:Memasukkan kata kunci atau memilih filter status / tanggal;

|System|
:Memfilter data riwayat dan memperbarui tampilan;
:Menampilkan daftar riwayat yang sesuai dengan filter;

|User|
if (Memilih aksi pada baris riwayat?) then (Lihat Hasil)
  :Menekan tombol SEE RESULT atau DETAIL LOG;
  |System|
  :Mengarahkan ke halaman Detail Analisis;
  stop

else (Hapus Riwayat)
  :Menekan ikon hapus pada baris riwayat;
  |System|
  :Menampilkan modal konfirmasi penghapusan;

  |User|
  if (Konfirmasi hapus?) then (Ya)
    |System|
    :Mengirim permintaan hapus ke backend;

    if (Hapus berhasil?) then (Ya)
      :Menghapus baris riwayat dari daftar;
    else (Tidak)
      :Menampilkan pesan kesalahan penghapusan;
    endif
  else (Batal)
    :Menutup modal tanpa menghapus;
  endif

endif

|User|
:Berpindah halaman (Prev / Next / Nomor Halaman);

stop
@enduml
