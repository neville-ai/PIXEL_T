@startuml activity-segmentation
' =====================================================================
'  Activity Diagram Segmentation - PIXEL-T (Versi Revisi Final)
'  Diverifikasi dari: analysis_service.py (_execute_pipeline),
'  ai/inference/pipeline.py, ai/inference/gradcam.py
'
'  Catatan penting:
'   - Segmentasi adalah proses BACKEND OTOMATIS (background job),
'     bukan aksi yang dipicu user secara langsung dari UI.
'   - Dipicu setelah upload gambar diterima (HTTP 202).
'   - Pipeline menghasilkan 4 artefak: binary mask, segmentation
'     overlay, Grad-CAM heatmap, dan Grad-CAM overlay.
'   - User hanya berinteraksi di akhir untuk melihat hasil.
' =====================================================================

title Activity Diagram Segmentation - PIXEL-T

skinparam backgroundColor white
skinparam activity {
  BackgroundColor #60E5E6
  BorderColor #333333
  FontColor #222222
  DiamondBackgroundColor #60E5E6
  DiamondBorderColor #333333
  StartColor black
  EndColor black
}
skinparam ArrowColor #333333
skinparam shadowing false

|System|
start
:Menerima gambar dari antrian analisis;
:Memvalidasi gambar;
note right
  Format, MIME type,
  dan dimensi gambar
end note

if (Gambar valid?) then (Ya)

  :Mempraproses gambar untuk inferensi;
  note right
    Resize ke ukuran input model
  end note

  :Menjalankan inferensi U-Net + ResNet50;
  note right
    Segmentasi polip dengan
    Test-Time Augmentation (TTA)
  end note

  if (Segmentasi berhasil?) then (Ya)

    :Menghasilkan binary mask segmentasi;
    :Menghasilkan segmentation overlay;

    :Menjalankan Generate Grad-CAM;
    note right
      Grad-CAM memvisualisasikan
      aktivasi model pada target layer
    end note

    :Menghasilkan Grad-CAM heatmap;
    :Menghasilkan Grad-CAM overlay;

    :Mengunggah 4 artefak ke Supabase Storage;
    note right
      binary mask, segmentation overlay,
      Grad-CAM heatmap, Grad-CAM overlay
    end note

    :Menyimpan hasil ke database;
    note right
      Status analisis diperbarui
      menjadi "completed"
    end note

    :Mengirim hasil analisis ke frontend;

    |User|
    :Melihat hasil segmentasi dan Grad-CAM;
    stop

  else (Tidak)

    |System|
    :Menyimpan status analisis "failed";

    |User|
    :Menerima notifikasi analisis gagal;
    stop

  endif

else (Tidak)

  :Menyimpan status analisis "failed";

  |User|
  :Menerima notifikasi gambar tidak valid;
  stop

endif

@enduml
