@startuml activity-sign-out
' =====================================================================
'  Activity Diagram Keluar (Sign Out) - PIXEL-T (Versi Revisi Final)
'  Diverifikasi dari: AppShell.tsx (requestSignOut, confirmSignOut),
'  AuthContext.tsx (signOut), services/auth.ts (logoutUser)
'
'  Alur mencerminkan implementasi aktual:
'   1. Pengguna memilih opsi Sign Out dari menu navigasi atau menu mobile.
'   2. Sistem menutup menu dan menampilkan modal konfirmasi keluar.
'   3. Jika pengguna mengkonfirmasi, sistem memanggil logoutUser()
'      yang memanggil supabase.auth.signOut() untuk menghapus sesi.
'   4. Sistem menghapus data user & session dari AuthContext,
'      lalu mengarahkan pengguna ke halaman Login.
' =====================================================================

title Activity Diagram Keluar (Sign Out) - PIXEL-T

skinparam backgroundColor white
skinparam activity {
  BackgroundColor #60E5E6
  BorderColor #333333
  FontColor #222222
  DiamondBackgroundColor #60E5E6
  DiamondBorderColor #333333
  StartColor black
  EndColor black
}
skinparam ArrowColor #333333
skinparam shadowing false

|User|
start
:Menekan tombol Sign Out pada menu navigasi;

|System|
:Menutup menu navigasi;
:Menampilkan modal konfirmasi keluar;

|User|
if (Konfirmasi keluar?) then (Ya)

  |System|
  :Memanggil fungsi keluar ke Supabase Auth;

  if (Keluar berhasil?) then (Ya)
    :Menghapus data pengguna dan sesi dari aplikasi;
    :Mengarahkan pengguna ke halaman Login;
    stop
  else (Tidak)
    :Menampilkan pesan kesalahan;
    :Menutup modal konfirmasi;
  endif

else (Batal)
  |System|
  :Menutup modal tanpa keluar dari akun;
endif

|User|
stop
@enduml
