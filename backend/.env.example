# Backend environment configuration template for PIXEL-T
# Copy this file to `.env` and fill in the real values. Do NOT commit `.env`.

# --- Application ---
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase (server-side only; never expose SERVICE_ROLE_KEY to the frontend) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=analysis-assets

# --- AI Model ---
MODEL_CHECKPOINT_PATH=ai/models/PIXEL-T_Scenario1_UNet_ResNet50_Ver22_best.pth
MODEL_DEVICE=auto
MODEL_INFERENCE_ENABLED=false
DOMAIN_VALIDATION_ENABLED=true

# --- LLM Domain Validation Gate (Gemini) ---
GEMINI_API_KEY=
LLM_VALIDATION_ENABLED=true
LLM_VALIDATION_MODEL=gemini-3.8-flash
LLM_VALIDATION_MIN_CONF=0.80
LLM_VALIDATION_TIMEOUT_S=30.0

# --- Server Secret ---
# Generate a cryptographically secure key (≥ 32 random characters).
# Example: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit the real value to version control.
SECRET_KEY=your-random-secret-key-minimum-32-chars
